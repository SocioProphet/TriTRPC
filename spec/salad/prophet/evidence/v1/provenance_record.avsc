{
  "type": "record",
  "name": "PROVENANCE_RECORD",
  "namespace": "io.socioprophet.prophet.v1",
  "doc": "Minimal provenance receipt for a submitted evidence object.",
  "fields": [
    {"name": "provenance_id", "type": "string"},
