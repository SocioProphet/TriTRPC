    {"name": "ingest_method", "type": "string"},
    {"name": "ingested_by", "type": "string"},
    {"name": "ingested_at", "type": "string"},
    {"name": "source_locator", "type": "string"},
    {"name": "attestation_refs", "type": {"type": "array", "items": "string"}, "default": []}
  ]
}
