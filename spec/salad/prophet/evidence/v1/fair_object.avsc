{
  "type": "record",
  "name": "FAIR_OBJECT",
  "namespace": "io.socioprophet.prophet.v1",
  "doc": "Canonical object descriptor for evidence-bearing content.",
  "fields": [
    {"name": "object_id", "type": "string"},
    {"name": "object_type", "type": "string"},
